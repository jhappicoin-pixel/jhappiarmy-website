        <!-- floating accents -->
        <svg style="position:absolute;right:16px;top:16px" width="40" height="40" viewBox="0 0 24 24"><path fill="#ff6b9a" d="M12 21s-6.716-4.534-9.75-7.567C.216 11.4.216 8.2 2.25 6.167c1.6-1.6 4.2-1.6 5.8 0L12 10.117l3.95-3.95c1.6-1.6 4.2-1.6 5.8 0c2.034 2.033 2.034 5.233 0 7.266C18.716 16.466 12 21 12 21z"/></svg>
