          <div class="kpi"><div class="lbl">Hugs Logged</div><div class="n" id="k2">0</div><div class="s" style="color:var(--muted);font-size:12px">since Day 1</div></div>
          <div class="kpi"><div class="lbl">Airdrop Spots</div><div class="n" id="k3">0</div><div class="s" style="color:var(--muted);font-size:12px">phase‑1</div></div>
