<!doctype html>

<html lang="hi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>JhappiArmy 💞 — $JHAPPI | No Rugs, Only Hugs</title>
  <meta name="description" content="JhappiArmy — Official $JHAPPI meme token. No Rugs, Only Hugs. Hug‑to‑Earn, airdrops, contests & community love on Solana." />
  <meta name="theme-color" content="#ff6b9a" />
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" as="style" onload="this.rel='stylesheet'">
  <style>
    :root{
      --pink:#ff6b9a;--pink2:#ff8fb3;--ink:#111827;--muted:#6b7280;--card:rgba(255,255,255,.94);
      --bg1:#fff7fb;--bg2:#fffef0;--ring:rgba(255,107,154,.25)
    }
    *{box-sizing:border-box}
    html,body{height:100%}
    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:var(--ink);
      background:linear-gradient(180deg,var(--bg1),var(--bg2));}
    .wrap{max-width:1060px;margin:0 auto;padding:20px}
    header{display:flex;align-items:center;justify-content:space-between;gap:12px;position:sticky;top:0;background:linear-gradient(180deg,rgba(255,247,251,.85),rgba(255,254,240,.85));backdrop-filter:blur(8px);z-index:20;border-bottom:1px solid rgba(0,0,0,.04)}
    .brand{display:flex;align-items:center;gap:12px;padding:10px 0}
    .logo{width:56px;height:56px;border-radius:14px;object-fit:cover;box-shadow:0 10px 30px rgba(0,0,0,.08)}
    h1{font-size:18px;margin:0}
    .tag{color:var(--muted);font-size:12px}
    .btn{display:inline-flex;align-items:center;gap:10px;padding:10px 16px;border-radius:12px;font-weight:800;text-decoration:none;border:2px solid transparent;transition:.2s}
    .btn-primary{background:linear-gradient(90deg,var(--pink),var(--pink2));color:#fff;box-shadow:0 10px 24px rgba(255,107,154,.35)}
    .btn-ghost{border-color:#ffdce8;color:#e11d48;background:transparent}
    .grid{display:grid;gap:18px}
    .hero{grid-template-columns:1.2fr .8fr;align-items:center;margin-top:16px}
    .card{background:var(--card);border-radius:16px;padding:16px;box-shadow:0 14px 40px rgba(2,6,23,.06)}
    .headline{font-size:34px;line-height:1.05;margin:0 0 8px}
    .sub{color:#374151;margin:0 0 12px}
    .pill{display:inline-flex;align-items:center;gap:8px;background:#fff;border:1px solid #ffe4ee;color:#e11d48;border-radius:999px;padding:6px 10px;font-weight:700;font-size:12px}
    .hero-art{height:320px;border-radius:20px;background:radial-gradient(120px 120px at 25% 25%,#fff0f6,transparent),linear-gradient(135deg,#fff0f6,#fffbe6);display:flex;align-items:center;justify-content:center;position:relative;box-shadow:0 14px 40px rgba(0,0,0,.08)}
    .hero-art img{width:170px;height:170px;border-radius:22px;object-fit:cover}.kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.kpi{background:#fff;border:1px solid #ffe4ee;border-radius:12px;padding:12px}
.kpi .n{font-size:28px;font-weight:800;color:var(--pink)}

.section h2{margin:0 0 8px;font-size:26px}
.badges{display:flex;flex-wrap:wrap;gap:10px;margin-top:8px}
.badge{background:#fff;border:1px solid #eee;border-radius:999px;padding:8px 12px;font-weight:700;font-size:12px}

.row{display:grid;grid-template-columns:1fr 1fr;gap:16px}

.timeline{position:relative;padding-left:18px}
.timeline::before{content:"";position:absolute;left:6px;top:4px;bottom:4px;width:2px;background:linear-gradient(var(--pink),transparent)}
.tl-item{position:relative;margin:10px 0;padding-left:12px}
.tl-item::before{content:"";position:absolute;left:-2px;top:6px;width:10px;height:10px;background:var(--pink);border-radius:50%;box-shadow:0 0 0 4px var(--ring)}
.tl-item strong{display:block}

.tokenomics{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.tok{background:#fff;border-radius:12px;border:1px solid #f5d0dc;padding:14px}
.tok .big{font-size:22px;font-weight:800;color:var(--pink)}

.faq details{background:#fff;border:1px solid #eee;border-radius:12px;padding:12px}
.faq details+details{margin-top:10px}
summary{cursor:pointer;font-weight:700}

footer{color:var(--muted);text-align:center;margin:28px 0 80px}

/* Floating hearts */
.hearts{position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:5}
.heart{position:absolute;opacity:.85;animation:floatUp 6s linear forwards}
@keyframes floatUp{from{transform:translateY(0) scale(.8)}to{transform:translateY(-120vh) scale(1.1);opacity:0}}

/* Modal */
.modal{position:fixed;inset:0;background:rgba(0,0,0,.35);display:none;align-items:center;justify-content:center;z-index:30}
.modal .box{background:#fff;border-radius:16px;padding:18px;max-width:420px;width:92%;box-shadow:0 18px 60px rgba(0,0,0,.2)}
.field{display:flex;gap:8px}
.field input{flex:1;padding:12px;border-radius:12px;border:1px solid #eee;outline:none}

/* Responsive */
@media (max-width:900px){.grid.hero{grid-template-columns:1fr}.row{grid-template-columns:1fr}.tokenomics{grid-template-columns:1fr 1fr}.kpis{grid-template-columns:1fr 1fr 1fr}}
@media (max-width:560px){.headline{font-size:28px}.tokenomics{grid-template-columns:1fr}.kpis{grid-template-columns:1fr 1fr}.hero-art{height:260px}}

  </style>
  <!-- SEO / Social -->
  <link rel="canonical" href="https://yourdomain/" />
  <meta property="og:title" content="JhappiArmy 💞 — $JHAPPI" />
