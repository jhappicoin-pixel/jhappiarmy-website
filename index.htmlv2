  </main>  <!-- AIRDROP MODAL -->  <div class="modal" id="airdropModal" aria-hidden="true">
    <div class="box">
      <h3 style="margin:0 0 8px">🎁 Airdrop Waitlist</h3>
      <p class="sub">अपना Telegram username डालो — हम वहीं अपडेट देंगे.</p>
      <div class="field">
        <input id="tg" placeholder="@yourusername" />
        <button class="btn btn-primary" id="saveLead">Join</button>
      </div>
      <p id="msg" style="color:var(--muted);font-size:12px;margin:10px 2px 0"></p>
    </div>
  </div>  <script>
    // Simple counters with localStorage memory
    (function(){
      const k1 = document.getElementById('k1');
      const k2 = document.getElementById('k2');
      const k3 = document.getElementById('k3');
      const st = JSON.parse(localStorage.getItem('jhappi_stats')||'{"m":120,"h":350,"s":500}')
      function bump(){
        st.m += Math.floor(Math.random()*5);
        st.h += Math.floor(Math.random()*9);
        st.s = 800; // fixed phase‑1 cap
        k1.textContent = st.m.toLocaleString('en-IN');
        k2.textContent = st.h.toLocaleString('en-IN');
        k3.textContent = st.s.toLocaleString('en-IN');
        localStorage.setItem('jhappi_stats', JSON.stringify(st));
      }
      bump();
      setInterval(bump, 4000);
    })();

    // Floating hearts spawner
    (function(){
      const box = document.getElementById('hearts');
      function spawn(){
        const s = Math.random()*24+12; // size
        const x = Math.random()*100;   // left%
        const el = document.createElement('div');
        el.className = 'heart';
        el.style.left = x + 'vw';
        el.style.bottom = '-40px';
        el.style.fontSize = s + 'px';
        el.textContent = '💞';
        el.style.animationDuration = (Math.random()*3+4)+'s';
        box.appendChild(el);
        setTimeout(()=>el.remove(), 7000);
      }
      setInterval(spawn, 900);
    })();

    // Airdrop modal
    (function(){
      const open = document.getElementById('airdropBtn');
      const modal = document.getElementById('airdropModal');
      const save = document.getElementById('saveLead');
      const msg = document.getElementById('msg');
      const input = document.getElementById('tg');
      open.addEventListener('click', ()=>{ modal.style.display='flex'; input.focus() })
      modal.addEventListener('click', (e)=>{ if(e.target===modal) modal.style.display='none' })
      save.addEventListener('click', ()=>{
        const v = (input.value||'').trim();
        if(!/^@?[a-zA-Z0-9_]{4,}$/.test(v)){ msg.textContent='Please enter a valid @username'; return }
        const u = v.startsWith('@')?v:'@'+v;
        const leads = JSON.parse(localStorage.getItem('jhappi_leads')||'[]');
        if(!leads.includes(u)) leads.push(u);
        localStorage.setItem('jhappi_leads', JSON.stringify(leads));
        msg.textContent = 'Added '+u+' ✅ — we will announce on Telegram.';
        input.value='';
      })
      window.addEventListener('keydown', (e)=>{ if(e.key==='Escape') modal.style.display='none' })
    })();
  </script></body>  <!--
